<UserControl x:Class="OrthoStreamXP.Gui.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="clr-namespace:OrthoStreamXP.Gui"
             x:ClassModifier="internal">
    <UserControl.Resources>
        <!-- A notice: coloured like a Windows 11 InfoBar -->
        <DataTemplate x:Key="NoticeTemplate">
            <Border x:Name="Bar" CornerRadius="6" Padding="14,12" Margin="0,8,0,0" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource InfoBarInformationalSeverityBackgroundBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{Binding Glyph}" VerticalAlignment="Top" Margin="0,2,12,0"
                               Foreground="{DynamicResource SystemFillColorAttentionBrush}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{Binding ActionLabel}" Command="{Binding Action}" CommandParameter="{Binding ActionParameter}"
                            Margin="16,0,0,0" VerticalAlignment="Center" Visibility="{Binding ActionLabel, Converter={StaticResource Visible}}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Error">
                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource InfoBarErrorSeverityBackgroundBrush}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource InfoBarWarningSeverityBackgroundBrush}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Success">
                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource InfoBarSuccessSeverityBackgroundBrush}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="Step" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28,36,36" MaxWidth="980">
            <TextBlock Text="Home" Style="{StaticResource PageTitle}" />

            <!-- What is happening, and the one button that matters -->
            <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="28" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="Good">
                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="Ready">
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="Busy">
                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding StatusGlyph}" FontSize="26"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <!-- Top, beside the icon: the right column grows with the SimBrief rows, and centred text would drift away from the icon -->
                    <StackPanel Grid.Column="1" Margin="20,4,20,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding StatusTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                        <ProgressBar IsIndeterminate="True" Margin="0,12,0,0" MaxWidth="320" HorizontalAlignment="Left" Width="320"
                                     Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <Button Command="{Binding StartStop}" Style="{DynamicResource AccentButtonStyle}" MinWidth="148" MinHeight="40"
                                Padding="20,6" FontSize="15" HorizontalAlignment="Right" AutomationProperties.Name="{Binding StartStopText}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding StartStopGlyph}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding StartStopText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding Fly}" MinWidth="148" MinHeight="34" Padding="16,4" Margin="0,8,0,0" HorizontalAlignment="Right"
                                ToolTip="{Binding FlyToolTip}" AutomationProperties.Name="{Binding FlyText}"
                                Visibility="{Binding ShowFly, Converter={StaticResource Visible}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE709;" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding FlyText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <CheckBox Content="Start when OrthoStreamXP opens" Style="{StaticResource Switch}" IsChecked="{Binding AutoStart}" Margin="0,12,0,0" HorizontalAlignment="Right" />
                        <CheckBox Content="Build my SimBrief flight's scenery ahead" Style="{StaticResource Switch}" IsChecked="{Binding DeparturePrefetch}"
                                  IsEnabled="{Binding CanChangeDeparturePrefetch}" Margin="0,8,0,0" HorizontalAlignment="Right"
                                  Visibility="{Binding ShowDeparturePrefetch, Converter={StaticResource Visible}}"
                                  ToolTip="For this session: when streaming starts, the photos around your latest SimBrief flight plan's departure are built before X-Plane loads them; while the aircraft stands at the gate, the arrival and the climb follow. Generated your flight plan after starting? Press Reload SimBrief flight plan. The switch can be changed while streaming is stopped and is on again the next time OrthoStreamXP opens; with Start when OrthoStreamXP opens on, streaming starts before you can turn it off."
                                  AutomationProperties.Name="Build my SimBrief flight's scenery ahead, this session" />
                        <Button Command="{Binding ReloadFlightPlan}" MinHeight="30" Padding="12,3" Margin="0,8,0,0" HorizontalAlignment="Right"
                                Visibility="{Binding ShowReloadFlightPlan, Converter={StaticResource Visible}}"
                                ToolTip="Generated your SimBrief flight plan after starting streaming, or planned another flight? Asks SimBrief for your latest flight plan now and builds its scenery. SimBrief is only asked when you press this."
                                AutomationProperties.Name="Reload SimBrief flight plan">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0" />
                                <TextBlock Text="Reload SimBrief flight plan" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding FlightPlanStatus}" TextWrapping="Wrap" MaxWidth="320" TextAlignment="Right" HorizontalAlignment="Right"
                                   Margin="0,4,0,0" Opacity="0.8" Visibility="{Binding ShowFlightPlanStatus, Converter={StaticResource Visible}}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Notices}" ItemTemplate="{StaticResource NoticeTemplate}" Focusable="False" />

            <!-- After a flight: what the tuning suggests, to apply or not -->
            <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,16,0,0" Visibility="{Binding ShowReview, Converter={StaticResource Visible}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" FontSize="22" VerticalAlignment="Top" Margin="0,2,14,0"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding ReviewTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ReviewText}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ReviewRows}" Focusable="False" Margin="36,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Setting}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,16,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Change}" FontWeight="SemiBold" />
                                    </Grid>
                                    <TextBlock Text="{Binding Why}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Apply" Command="{Binding ApplyReview}" Style="{DynamicResource AccentButtonStyle}" MinWidth="96"
                                Visibility="{Binding CanApplyReview, Converter={StaticResource Visible}}" />
                        <Button Content="No, thanks" Command="{Binding DismissReview}" MinWidth="96" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- After a flight: how it went -->
            <StackPanel Visibility="{Binding ShowReport, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding ReportTitle}" Style="{StaticResource SectionTitle}" />
                <Border>
                    <StackPanel>
                        <!-- The verdict: smooth, a few blurry moments, or often blurry -->
                        <Border CornerRadius="6" Padding="14,12" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource InfoBarSuccessSeverityBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ReportVerdict.Rating}" Value="Fair">
                                            <Setter Property="Background" Value="{DynamicResource InfoBarWarningSeverityBackgroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ReportVerdict.Rating}" Value="Poor">
                                            <Setter Property="Background" Value="{DynamicResource InfoBarErrorSeverityBackgroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="20" VerticalAlignment="Top" Margin="0,1,12,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Setter Property="Text" Value="&#xE930;" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ReportVerdict.Rating}" Value="Fair">
                                                    <Setter Property="Text" Value="&#xE7BA;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ReportVerdict.Rating}" Value="Poor">
                                                    <Setter Property="Text" Value="&#xEA39;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding ReportVerdict.Title}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ReportVerdict.Text}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- The figures, each with what it means -->
                        <ItemsControl ItemsSource="{Binding ReportStats}" Focusable="False" Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6,16,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="Disc" Width="36" Height="36" CornerRadius="18" VerticalAlignment="Top" Margin="0,2,12,0"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" />
                                            <TextBlock x:Name="Value" Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Rating}" Value="Good">
                                            <Setter TargetName="Disc" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Rating}" Value="Fair">
                                            <Setter TargetName="Disc" Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Rating}" Value="Poor">
                                            <Setter TargetName="Disc" Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <gui:FlightChart Report="{Binding Report}" Height="170" />
                                <WrapPanel Margin="40,8,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                        <Grid Width="16" Height="10" Margin="0,0,6,0">
                                            <Rectangle Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.35" />
                                            <Rectangle Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="1" />
                                        </Grid>
                                        <TextBlock Text="Download speed (Mbit/s, left)" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                        <Rectangle Width="16" Height="2.5" Fill="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Textures built a minute (right)" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                        <Rectangle Width="2.5" Height="10" Fill="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="Blurry moment" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Left">
                                <gui:RouteMap Report="{Binding Report}" Backdrop="{Binding ReportBackdrop}" Width="300" Height="170" />
                                <WrapPanel Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                        <Ellipse Width="10" Height="10" Fill="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="Start" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                        <Ellipse Width="10" Height="10" Fill="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="End" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                        <Ellipse Width="10" Height="10" Fill="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="Blurry here" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- First time: how it works -->
            <StackPanel Visibility="{Binding ShowGettingStarted, Converter={StaticResource Visible}}">
                <TextBlock Text="How it works" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Padding="20">
                    <UniformGrid Columns="3">
                        <Grid Margin="0,0,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Step}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <StackPanel Grid.Column="1" Margin="12,3,0,0">
                                <TextBlock Text="Start OrthoStreamXP" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0"
                                           Text="It shows your scenery packages to X-Plane, with photos added as they are needed." />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Step}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <StackPanel Grid.Column="1" Margin="12,3,0,0">
                                <TextBlock Text="Start X-Plane" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0"
                                           Text="Load a flight. OrthoStreamXP downloads the pictures and builds them ahead of the aircraft." />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Step}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <StackPanel Grid.Column="1" Margin="12,3,0,0">
                                <TextBlock Text="Fly" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0"
                                           Text="A new area takes a few minutes to load the first time; after that it comes from the cache." />
                            </StackPanel>
                        </Grid>
                    </UniformGrid>
                </Border>
            </StackPanel>

            <!-- Live numbers -->
            <StackPanel Visibility="{Binding ShowStats, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding StatsTitle}" Style="{StaticResource SectionTitle}" />
                <UniformGrid Columns="4">
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{Binding TexturesValue}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="textures given to X-Plane" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="{Binding ReadyAheadValue}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="{Binding ReadyAheadCaption}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="{Binding BuildingValue}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="being built now" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding SpeedValue}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="{Binding SpeedCaption}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>

            <!-- X-Plane and quality -->
            <UniformGrid Columns="2" Margin="0,20,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding XPlaneGlyph}" FontSize="22" VerticalAlignment="Top" Margin="0,2,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="X-Plane" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding XPlaneTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding XPlaneText}" Style="{StaticResource Secondary}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE91B;" FontSize="22" VerticalAlignment="Top" Margin="0,2,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Quality" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding QualityTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding QualityText}" Style="{StaticResource Secondary}" Margin="0,6,0,0" />
                            <Button Content="Change quality" Style="{StaticResource LinkButton}" Command="{Binding ChangeQuality}" Margin="0,8,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Packages -->
            <StackPanel Visibility="{Binding Packages.Count, Converter={StaticResource Visible}}">
                <TextBlock Text="Scenery packages" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding PackagesCaption}" Style="{StaticResource Caption}" Margin="2,-4,0,8" />
                <ItemsControl ItemsSource="{Binding Packages}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RowCard}" MinHeight="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE909;" Margin="0,0,14,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Where}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
