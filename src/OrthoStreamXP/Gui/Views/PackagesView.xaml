<UserControl x:Class="OrthoStreamXP.Gui.PackagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="clr-namespace:OrthoStreamXP.Gui"
             x:ClassModifier="internal">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28,36,36" MaxWidth="900">
            <TextBlock Text="Packages" Style="{StaticResource PageTitle}" />

            <TabControl SelectedIndex="{Binding Tab}" Margin="0,8,0,0" Background="Transparent" BorderThickness="0" Padding="0,12,0,0">
                <TabItem Header="Build own packages">
                    <gui:BuildSceneryView DataContext="{Binding Build}" />
                </TabItem>
                <TabItem Header="Download kubilus1 packages">
                    <StackPanel DataContext="{Binding Download}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PageIntro}" Margin="0,0,16,12"
                                       Text="No scenery packages for where you fly? Download the ground mesh of a whole region here. OrthoStreamXP then streams the photos onto it like onto your own packages." />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="Open the folder" Command="{Binding OpenFolder}" />
                                <Button Content="Refresh" Command="{Binding Refresh}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding FolderText}" Margin="0,0,0,12" />
                        <gui:RegionListView />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
