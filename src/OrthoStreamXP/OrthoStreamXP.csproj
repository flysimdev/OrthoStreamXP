<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>orthostreamxp</AssemblyName>
    <RootNamespace>OrthoStreamXP</RootNamespace>
    <Version>1.1.0</Version>
    <ApplicationIcon>orthostreamxp.ico</ApplicationIcon>
    <!-- The program is the window; app.manifest keeps Explorer from opening a console. -->
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon (NotifyIcon), which WPF lacks; same Windows Desktop runtime as WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF's Windows 11 (Fluent) theme is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- "dotnet publish" produces one orthostreamxp.exe (the .NET 10 runtime is still required). -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <!-- WinFsp installs its managed API next to the native DLLs; override with -p:WinFspDir=... if needed. -->
    <WinFspDir Condition="'$(WinFspDir)' == ''">$(MSBuildProgramFiles32)\WinFsp</WinFspDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Image decoding only (JPEG/PNG tiles); resizing is our own code, BC1 encoding Intel's ISPC (below). -->
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <!-- Laminar's 7z-packed Global Scenery DSFs, read and written by OrthoGlobalXP.Core (below): its one dependency, same version. -->
    <PackageReference Include="SharpCompress" Version="0.50.10" />
  </ItemGroup>

  <ItemGroup>
    <!--
      OrthoGlobalXP's engine (the Build Scenery page): photo-terrain packages made from X-Plane's own Global Scenery.
      Compiled and checked in by lib\OrthoGlobalXP.Core\build.ps1; bundled into the single-file exe.
    -->
    <Reference Include="OrthoGlobalXP.Core">
      <HintPath>..\..\lib\OrthoGlobalXP.Core\OrthoGlobalXP.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!--
      Intel's ISPC Texture Compressor (MIT), the BC1 encoder (Textures\Dds\IspcBc1.cs): built by native\ispc_texcomp\build.ps1.
      It sits next to orthostreamxp.exe, outside the single-file bundle, where the program loads it by path.
    -->
    <None Include="..\..\native\ispc_texcomp\ispc_texcomp.dll" Link="ispc_texcomp.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only the example is shipped, so publishing never overwrites the user's orthostreamxp.ini. -->
    <None Update="orthostreamxp.example.ini" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="orthostreamxp.ico" />
    <Resource Include="orthostreamxp.png" />
    <!-- City names for the maps: Natural Earth's populated places (public domain). -->
    <EmbeddedResource Include="Gui\Map\cities.csv" LogicalName="OrthoStreamXP.cities.csv" />
    <!-- The colours of NASA GIBS's vegetation index pictures (its colour map MODIS_L3_NDVI), for the seasons' satellite record. -->
    <EmbeddedResource Include="Textures\Vegetation\ndvi-colormap.xml" LogicalName="OrthoStreamXP.ndvi-colormap.xml" />
    <!-- WPF projects leave these out of the implicit usings; the engine uses them everywhere. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <!-- Windows Forms is used by name only (Gui\TrayIcon.cs): its types would clash with WPF's (Application, MessageBox, Point...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="winfsp-msil">
      <HintPath>$(WinFspDir)\bin\winfsp-msil.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OrthoStreamXP.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Every decoded tile (196 KB) and build picture (up to 64 MB) is a large object, which .NET does not move by default:
      a flight's hundreds of thousands of them among the long-lived cached ones can leave the heap mostly free gaps
      (a 4-8 GB heap was seen with about 1 GB of textures held) that X-Plane cannot have. ConserveMemory compacts the
      large objects when the gaps grow.
    -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <!--
    Keep the publish folder to the exe, WinFsp's managed DLL, ispc_texcomp.dll and the example settings: no SkiaSharp native
    symbols (~96 MB) or WinFsp API docs. winfsp-msil.dll stays a separate file because it checks its own
    file version at start-up, which fails inside a single-file bundle (its location is empty there).
  -->
  <Target Name="ShapePublishFolder" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' or '%(Extension)' == '.xml'" />
      <ResolvedFileToPublish Condition="'%(Filename)' == 'winfsp-msil'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
