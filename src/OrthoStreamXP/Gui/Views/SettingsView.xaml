<UserControl x:Class="OrthoStreamXP.Gui.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="clr-namespace:OrthoStreamXP.Gui"
             x:ClassModifier="internal">
    <UserControl.Resources>
        <!-- A preset card's content -->
        <DataTemplate x:Key="PresetTemplate">
            <RadioButton Style="{StaticResource ChoiceCard}"
                         IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                        <Border Style="{StaticResource Badge}" Visibility="{Binding IsRecommended, Converter={StaticResource Visible}}">
                            <TextBlock Text="Recommended" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding RecommendedReason}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               Visibility="{Binding RecommendedReason, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding BestFor}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding MemoryText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding MemoryWarning, Converter={StaticResource Visible}}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="14" VerticalAlignment="Top" Margin="0,1,8,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="{Binding MemoryWarning}" TextWrapping="Wrap" MaxWidth="640" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    </StackPanel>
                </StackPanel>
            </RadioButton>
        </DataTemplate>

        <!-- A setting: label and explanation on the left, its control on the right -->
        <DataTemplate x:Key="FieldTemplate">
            <Border Style="{StaticResource RowCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Help}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                   Visibility="{Binding Help, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="12" Margin="0,4,0,0"
                                   Visibility="{Binding Error, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="Number" Width="110" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" Visibility="Collapsed"
                                 AutomationProperties.Name="{Binding Label}" HorizontalContentAlignment="Right" />
                        <TextBox x:Name="Text" Width="260" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" Visibility="Collapsed"
                                 AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Placeholder}" />
                        <Button x:Name="Browse" Content="Browse…" Command="{Binding Browse}" Margin="8,0,0,0" Visibility="Collapsed" />
                        <CheckBox x:Name="Toggle" Style="{StaticResource Switch}" IsChecked="{Binding IsOn}" Visibility="Collapsed"
                                  AutomationProperties.Name="{Binding Label}" Content="{Binding OnOffText}" />
                        <ComboBox x:Name="Choice" Width="300" ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedChoice}" Visibility="Collapsed" AutomationProperties.Name="{Binding Label}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Number">
                    <Setter TargetName="Number" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Text">
                    <Setter TargetName="Text" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Folder">
                    <Setter TargetName="Text" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Browse" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Toggle">
                    <Setter TargetName="Toggle" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Choice">
                    <Setter TargetName="Choice" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A folder: path, Browse, and whether it is right -->
        <Style x:Key="StatusLine" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28,36,36" MaxWidth="900">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />

            <!-- While the streaming runs (or starts or stops): the settings are shown, not editable -->
            <Border CornerRadius="6" Padding="14,12" Margin="0,8,0,8" BorderThickness="1" Background="{DynamicResource InfoBarWarningSeverityBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Visibility="{Binding IsLocked, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" VerticalAlignment="Top" Margin="0,2,12,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LockedText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="These are the settings the streaming uses now. Changes apply from its next start." TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Stop streaming" Command="{Binding StopStreaming}" Style="{DynamicResource AccentButtonStyle}"
                            Margin="16,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <TextBlock Text="{Binding SaveError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding SaveError, Converter={StaticResource Visible}}" />

            <!-- Grouped in tabs; the restart banner, the "Saved" note and the file stay in view -->
            <TabControl SelectedIndex="{Binding Tab}" Margin="0,8,0,0" Background="Transparent" BorderThickness="0" Padding="0,12,0,0">
                <TabItem Header="Quality">
                    <StackPanel Margin="0,4,0,0" IsEnabled="{Binding CanEdit}">
                        <!-- Quality -->
                        <TextBlock Style="{StaticResource Caption}" Margin="2,0,0,10"
                                   Text="How sharp the ground is, how much graphics memory it takes, and how long a new area takes to load. Each choice comes with settings tested for it, and keeps its own textures in the cache, so you can switch at any time." />
                        <ItemsControl ItemsSource="{Binding Presets}" ItemTemplate="{StaticResource PresetTemplate}" Focusable="False" />
                        <TextBlock Text="{Binding CustomLevelNote}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="2,0,0,8"
                                   Visibility="{Binding CustomLevelNote, Converter={StaticResource Visible}}" />

                        <!-- Ground detail: X-Plane's decals over the photos -->
                        <TextBlock Text="Ground detail" Style="{StaticResource SectionTitle}" FontSize="16" Margin="2,28,0,2" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="2,0,0,10" TextWrapping="Wrap"
                                   Text="X-Plane's own grass and dirt texture, drawn over the photos up close." />
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Ground detail" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="Adds a grass and dirt pattern on top of the photos, seen when you are on the ground or flying low. At 0 % (the default) the ground looks exactly like the photos: clean and sharp. Higher values give the ground more texture up close, but make the photos look grainier. Try it if the ground looks too flat to you during taxi or landing." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider Width="200" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            Value="{Binding GroundDetail, Delay=400}" AutomationProperties.Name="Ground detail" />
                                    <TextBlock Text="{Binding GroundDetailText}" Width="80" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Folders">
                    <StackPanel Margin="0,4,0,0" IsEnabled="{Binding CanEdit}">
                        <!-- Folders -->
                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Text="X-Plane folder" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding XPlaneFolder, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="X-Plane folder" />
                                    <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseXPlane}" Margin="8,0,0,0" />
                                </Grid>
                                <TextBlock Text="{Binding XPlaneStatus}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusLine}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding XPlaneOk}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Text="Scenery packages folder" />
                                <TextBlock Style="{StaticResource Caption}" Text="The folder that holds your scenery packages: each is a folder with an Earth nav data folder in it." />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding PackagesFolder, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Scenery packages folder" />
                                    <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowsePackages}" Margin="8,0,0,0" />
                                </Grid>
                                <TextBlock Text="{Binding PackagesStatus}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusLine}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PackagesOk}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <TextBlock Text="Cache folder" />
                                <TextBlock Style="{StaticResource Caption}" Text="Where OrthoStreamXP keeps the textures it builds. A fast SSD with plenty of space is best." />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding CacheFolder, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Cache folder" />
                                    <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCache}" Margin="8,0,0,0" />
                                </Grid>
                                <TextBlock Text="{Binding CacheStatus}" Style="{StaticResource StatusLine}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </TabItem>
                <TabItem Header="Pictures and download">
                    <StackPanel Margin="0,4,0,0" IsEnabled="{Binding CanEdit}">
                        <!-- Pictures and download -->
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Where the pictures come from" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="Bing has the sharpest pictures in most places; Esri fills the gaps." />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Width="300" VerticalAlignment="Center" ItemsSource="{Binding Providers}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding Provider}" AutomationProperties.Name="Where the pictures come from" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Downloads at once" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                               Text="Your internet connection sets the speed: beyond about 160 more downloads only wait longer. Lower it if other programs need the connection while you fly." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider Width="200" Minimum="16" Maximum="256" TickFrequency="16" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            Value="{Binding DownloadWorkers, Delay=400}" AutomationProperties.Name="Downloads at once" />
                                    <TextBlock Text="{Binding DownloadWorkersText}" Width="80" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RowCard}" DataContext="{Binding ConnectionTest}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Test my connection" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" Text="About 30 seconds and 30 MB of real picture tiles from your chosen source, to suggest the downloads at once and the quality your connection keeps up with. Not while the scenery is streaming." />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               Text="Speeds change during the day: test a few times, at different hours, and choose a number in the middle of the results." />
                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Status}"
                                               Visibility="{Binding Status, Converter={StaticResource Visible}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding UseText}" Command="{Binding Use}" Margin="0,0,8,0" Padding="12,4"
                                            Visibility="{Binding CanUse, Converter={StaticResource Visible}}" />
                                    <Button Content="{Binding RunText}" Command="{Binding Run}" Padding="12,4" AutomationProperties.Name="Test my connection" />
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </TabItem>
                <TabItem Header="Colours">
                    <StackPanel Margin="0,4,0,0">
                        <!-- Preview: a photo from the cache before and after the settings below (shown while streaming too) -->
                        <Border Style="{StaticResource RowCard}" DataContext="{Binding ColourPreview}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                        <TextBlock Text="Preview" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Text="A photo from your cache, as downloaded and as X-Plane will get it with the settings below." />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Another photo" Command="{Binding NextPhoto}" Padding="12,4" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding Status}"
                                           Visibility="{Binding Status, Converter={StaticResource Visible}}" />
                                <Grid Margin="0,12,0,0" Visibility="{Binding HasPicture, Converter={StaticResource Visible}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Before" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                    <TextBlock Grid.Column="2" Text="After" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                    <Image Grid.Row="1" Source="{Binding Before}" MaxWidth="360" Stretch="Uniform" HorizontalAlignment="Left"
                                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="The photo as downloaded" />
                                    <Image Grid.Row="1" Grid.Column="2" Source="{Binding After}" MaxWidth="360" Stretch="Uniform" HorizontalAlignment="Left"
                                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="The photo with the colour settings" />
                                </Grid>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding HasPicture, Converter={StaticResource Visible}}">
                                    <Run Text="{Binding Place, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Notes, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    <StackPanel IsEnabled="{Binding CanEdit}">
                        <!-- Colour matching -->
                        <TextBlock Text="Colour matching" Style="{StaticResource SectionTitle}" FontSize="16" Margin="2,28,0,2" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="2,0,0,10"
                                   Text="Makes the photos fit together: neighbouring pictures from different days look less like patches." />
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Even out the colours between photos" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="The photos are a patchwork of pictures taken on different days: next to each other, one can be grey and hazy and another bright and green. This moves each place towards the colours usual in its area, by its brightness and tint, so the patches stand out less. Fields keep their own colours, and a photo taken almost without colour stays muted. Your cache keeps the photos as downloaded: changing this never downloads them again." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding MatchColoursOn}" Content="{Binding MatchColoursOnText}"
                                          AutomationProperties.Name="Even out the colours between photos" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RowCard}" IsEnabled="{Binding MatchColoursOn}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Strength" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="How far each photo moves towards the colours usual in its area. 100 % is the full correction; less keeps more of each photo's own look." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider Width="200" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            Value="{Binding MatchStrength, Delay=400}" AutomationProperties.Name="Colour matching strength" />
                                    <TextBlock Text="{Binding MatchStrengthText}" Width="80" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Seasons -->
                        <TextBlock Text="Seasons" Style="{StaticResource SectionTitle}" FontSize="16" Margin="2,28,0,2" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="2,0,0,10"
                                   Text="Changes the colours of the vegetation to the season of your flight." />
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Colour the scenery for the season" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="Most photos are taken in summer. This turns leaves yellow and rust in autumn, leaves trees bare and fields brown in winter, and makes spring fresh green, by X-Plane's date and the place (the southern hemisphere too). Conifers, roofs, roads and water stay as they are, and snow is left to X-Plane's weather. Your cache keeps the photos as downloaded: changing this never downloads them again." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding SeasonsOn}" Content="{Binding SeasonsOnText}"
                                          AutomationProperties.Name="Colour the scenery for the season" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RowCard}" IsEnabled="{Binding SeasonsOn}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Season" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="Automatic follows the date of your flight in X-Plane; a new date shows from the next flight." />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Width="300" VerticalAlignment="Center" ItemsSource="{Binding SeasonChoices}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding Season}" AutomationProperties.Name="Season" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RowCard}" IsEnabled="{Binding SeasonsOn}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Strength" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="How far the colours move towards the season. 100 % is the full change." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider Width="200" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            Value="{Binding SeasonStrength, Delay=400}" AutomationProperties.Name="Season strength" />
                                    <TextBlock Text="{Binding SeasonStrengthText}" Width="80" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Exposure -->
                        <TextBlock Text="Exposure" Style="{StaticResource SectionTitle}" FontSize="16" Margin="2,28,0,2" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="2,0,0,10"
                                   Text="Darkens photos that look too bright next to X-Plane's own scenery." />
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Exposure" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="How much light the photos let through, like a camera's exposure. 100 % shows them as downloaded; 50 % is one stop darker. Your cache keeps the photos as downloaded: changing this never downloads them again." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider Width="200" Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            Value="{Binding Exposure, Delay=400}" AutomationProperties.Name="Exposure" />
                                    <TextBlock Text="{Binding ExposureText}" Width="80" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Night">
                    <StackPanel Margin="0,4,0,0" IsEnabled="{Binding CanEdit}">
                        <!-- Night lights: street lamps on the photo scenery after dark -->
                        <TextBlock Text="Night lights" Style="{StaticResource SectionTitle}" FontSize="16" Margin="2,0,0,2" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="2,0,0,10" TextWrapping="Wrap"
                                   Text="Towns lit at night, as on X-Plane's own scenery." />
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Light the towns at night" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="Without this, the photo scenery is dark at night except for X-Plane's roads and buildings. With it on, street lamps, their glow and lit windows are drawn along X-Plane's roads, more in towns than in the country, and X-Plane fades them in at dusk. The roads come from the overlays installed with your regions. Each tile's lights are made the first time X-Plane loads it and kept in the cache, so the first flight over an area takes a little more processor time." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding NightLightsOn}" Content="{Binding NightLightsOnText}"
                                          AutomationProperties.Name="Light the towns at night" />
                            </Grid>
                        </Border>

                        <!-- Photos at night: no detailed photos downloaded while it is night in X-Plane -->
                        <TextBlock Text="Photos at night" Style="{StaticResource SectionTitle}" FontSize="16" Margin="2,28,0,2" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="2,0,0,10" TextWrapping="Wrap"
                                   Text="Fewer downloads on night flights, when the ground is too dark to see much of the photos." />
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Skip the photos at night" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="With this on, no detailed photos are downloaded while it is dark in X-Plane: the ground is a lover zoom level version of the photos, and the night lights, when they are on, shine on it as usual. Places you have flown over before stay sharp, and around sunset and sunrise the photos download as usual." />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="When a flight starts, X-Plane loads the area around the aircraft before it tells OrthoStreamXP the time of day, so that first area still gets its photos; the saving starts once the flight is running." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding SkipPhotosAtNight}" Content="{Binding SkipPhotosAtNightText}"
                                          AutomationProperties.Name="Skip the photos at night" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Tuning">
                    <StackPanel Margin="0,4,0,0" IsEnabled="{Binding CanEdit}">
                        <!-- Tuning: what the flights changed, and the way back -->
                        <Border Style="{StaticResource RowCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                        <TextBlock Text="Tuned from your flights" />
                                        <TextBlock Text="{Binding TuningText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Reset to defaults" Command="{Binding AskReset}" VerticalAlignment="Center" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding TunedRows}" Focusable="False" Margin="0,4,0,0"
                                              Visibility="{Binding TunedRows.Count, Converter={StaticResource Visible}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,16,0" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Value}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Default}" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Asked in place, not in a pop-up -->
                                <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="6" Background="{DynamicResource InfoBarWarningSeverityBackgroundBrush}"
                                        Visibility="{Binding ConfirmingReset, Converter={StaticResource Visible}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ResetQuestion}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                                            <Button Content="Reset" Command="{Binding Reset}" Style="{DynamicResource AccentButtonStyle}" />
                                            <Button Content="Cancel" Command="{Binding CancelReset}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </TabItem>
                <TabItem Header="SimBrief">
                    <StackPanel Margin="0,4,0,0" IsEnabled="{Binding CanEdit}">
                        <!-- The username, saved as it is typed, so the test below asks with what is in the box -->
                        <Border Style="{StaticResource RowCard}" DataContext="{Binding SimBriefUser}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBlock Text="{Binding Help}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Width="260" VerticalAlignment="Center" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                         ToolTip="{Binding Placeholder}" AutomationProperties.Name="{Binding Label}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RowCard}" DataContext="{Binding SimBriefTest}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Check your SimBrief account" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="Looks up your latest flight plan, so you know OrthoStreamXP finds it." />
                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Status}"
                                               Visibility="{Binding Status, Converter={StaticResource Visible}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Failed}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Center" Content="{Binding RunText}" Command="{Binding Run}" Padding="12,4"
                                        AutomationProperties.Name="Test SimBrief connection" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding SimBrief}" ItemTemplate="{StaticResource FieldTemplate}" Focusable="False" />
                        <!-- Why the download limit exists, so the value can be chosen knowingly -->
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" VerticalAlignment="Top" Margin="0,2,12,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{x:Static gui:SimBriefText.LimitWhy}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Other">
                    <StackPanel Margin="0,4,0,0" IsEnabled="{Binding CanEdit}">
                        <!-- The little the presets do not decide -->
                        <ItemsControl ItemsSource="{Binding Other}" ItemTemplate="{StaticResource FieldTemplate}" Focusable="False" />

                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- Where it is saved -->
            <StackPanel Orientation="Horizontal" Margin="2,24,0,0">
                <TextBlock Style="{StaticResource Caption}" Text="Saved in " VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding FilePath}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                <Button Content="Show the file" Style="{StaticResource LinkButton}" Command="{Binding OpenFile}" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center" />
                <Button Content="Run the setup again" Style="{StaticResource LinkButton}" Command="{Binding RunSetup}" Margin="16,0,0,0" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

    <!-- "Saved": a moment after each change, over the page -->
    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24" Padding="14,10" CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            Opacity="0" IsHitTestVisible="False" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding ToastText}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" />
        </Border.Effect>
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowToast}" Value="True">
                        <Setter Property="IsHitTestVisible" Value="True" />
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,10,0" />
            <TextBlock Text="{Binding ToastText}" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
    </Grid>
</UserControl>
